{
  "expo": {
    "name": "Asphalt Run",
    "slug": "asphalt-run-qlfeip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-fnh.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/app-icon-fnh.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1F22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asphaltrun.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Asphalt Run precisa da sua localização para rastrear corridas."
      },
      "config": {
        "googleMapsApiKey": ""
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-fnh.png",
        "backgroundColor": "#1C1F22"
      },
      "package": "com.asphaltrun.app",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Asphalt Run precisa da sua localiza\u00e7\u00e3o em segundo plano para continuar rastreando sua corrida com o app minimizado.",
          "locationWhenInUsePermission": "Asphalt Run precisa da sua localiza\u00e7\u00e3o para rastrear corridas.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "scheme": "asphaltrun",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}